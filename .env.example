# ── Server-only (never sent to the browser) ─────────────────────────────
# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── Public ──────────────────────────────────────────────────────────────
# The public address of the site (used in sign-in links and invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile site key for the bot check on the sign-in form.
# Leave empty to switch it off. The matching secret key goes in Supabase, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to "off" to show only "Continue with Google" (useful before you set up an email sender).
EMAIL_SIGNIN=
